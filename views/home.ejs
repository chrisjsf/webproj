<%- include("partials/header", { title }) %>
<section class="intro">
  <div class="intro-copy">
    <p class="eyebrow">A STUDENT-RUN CAMPUS SERVICE</p>
    <h1>Lost something on campus?</h1>
    <p>Check recent reports, let other students know what you found, and help return belongings to their owners.</p>
    <div class="actions">
      <a class="button" href="/items">Browse items</a>
      <a class="button secondary" href="/items/report">Report an item</a>
      <% if (!currentUser) { %><a class="text-link" href="/login">Student login</a><% } %>
    </div>
  </div>
  <aside class="intro-note">
    <h2>Keep it useful</h2>
    <p>Describe identifying details carefully. For a found item, keep one detail private so its owner can verify a claim.</p>
  </aside>
</section>

<section class="plain-section">
  <div class="section-heading">
    <p class="eyebrow">SIMPLE STEPS</p>
    <h2>How the portal works</h2>
  </div>
  <div class="steps-list">
    <article class="step-card">
      <span class="step-number">01</span>
      <h3>Report or browse</h3>
      <p>Sign in with your student account to report an item, or browse reports already shared by others.</p>
    </article>
    <article class="step-card">
      <span class="step-number">02</span>
      <h3>Make a claim</h3>
      <p>If a found item could be yours, explain how you can identify it.</p>
    </article>
    <article class="step-card">
      <span class="step-number">03</span>
      <h3>Verify and return</h3>
      <p>An administrator reviews claims and updates the item after a verified handover.</p>
    </article>
  </div>
</section>
<%- include("partials/footer") %>
